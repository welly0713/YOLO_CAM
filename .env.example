# =========================
# 影像來源：rtsp（正式監視器）或 webcam（先用本機鏡頭測試）
CAMERA_SOURCE=rtsp

# 本機鏡頭測試設定。Windows 通常 index=0 就是內建鏡頭。
WEBCAM_INDEX=0
WEBCAM_WIDTH=1280
WEBCAM_HEIGHT=720
# 0 代表使用鏡頭預設 FPS。
WEBCAM_FPS=0
# 本機測試可改成 true，會開啟影像預覽視窗；Docker/headless 請維持 false。
SHOW_PREVIEW=false

# RTSP 監視器連線設定
# =========================
# 若使用一般格式，填以下欄位即可：
# rtsp://帳號:密碼@IP:Port/路徑
RTSP_SCHEME=rtsp
RTSP_HOST=192.168.1.100
RTSP_PORT=554
RTSP_USERNAME=admin
RTSP_PASSWORD=change-me
RTSP_PATH=/Streaming/Channels/101

# 若監視器使用特殊 URL，可直接填 RTSP_URL；填寫後會優先使用它。
# 請注意：這裡也可能包含帳號密碼，不要提交到 Git。
RTSP_URL=

# tcp 通常比 udp 穩定；目前作為設定紀錄，OpenCV 會優先使用 FFmpeg backend。
RTSP_TRANSPORT=tcp
RTSP_OPEN_TIMEOUT_SECONDS=10
RTSP_RECONNECT_DELAY_SECONDS=5

# =========================
# YOLO 偵測設定
# =========================
# 第一次啟動若檔案不存在，Ultralytics 會自動下載模型。
MODEL_PATH=/app/yolo26m.pt
YOLO_IMAGE_SIZE=640
YOLO_DEVICE=cpu
# 只偵測 person，信心度至少要達到此值才算有人。
PERSON_CONFIDENCE=0.5

# 每秒監測一次。
SAMPLE_INTERVAL_SECONDS=1
# 最近 15 秒（約 15 次取樣）中，至少 2/3 次偵測到人就告警。
DETECTION_WINDOW_SECONDS=15
DETECTION_MIN_RATIO=0.6666667
# 同一個人事件結束後，至少等幾秒才允許再次告警。
ALERT_COOLDOWN_SECONDS=300
# RTSP 影像超過此秒數沒有更新，就把該次取樣視為沒有人。
MAX_FRAME_AGE_SECONDS=5

# =========================
# Email / SMTP 設定（目前預設不寄信）
# =========================
# 你提到的 email「sftp」應該是 SMTP；先把未來會用到的欄位預留在這裡。
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=change-me
SMTP_USE_TLS=true
EMAIL_FROM=your-email@example.com
# 可填一個或多個收件人，用逗號分隔。
EMAIL_TO=your-email@example.com
EMAIL_SUBJECT=YOLO CAM person detected
# 每封警報信會附上目前偵測窗內每一張偵測到人的完整畫面。

# =========================
# Web 中控台與取水口 ROI
# =========================
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Docker 中建議使用 /data/cameras.json，並以 volume 保存。
CAMERA_CONFIG_PATH=data/cameras.json
DASHBOARD_SETTINGS_PASSWORD=change-me
# Optional; if empty, a new session secret is generated each process start.
DASHBOARD_SESSION_SECRET=
# 同一人持續位於 ROI 多少秒後才警報。
ROI_DWELL_SECONDS=10

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
