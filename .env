# 這是一份不含真實密碼的本機設定範本，請依實際設備修改。
# 此檔案已加入 .gitignore 與 .dockerignore，不應提交或分享。

# 先用本機鏡頭測試；正式接上監視器後改成 CAMERA_SOURCE=rtsp。
CAMERA_SOURCE=webcam
WEBCAM_INDEX=0
WEBCAM_WIDTH=1280
WEBCAM_HEIGHT=720
WEBCAM_FPS=0
SHOW_PREVIEW=true

# RTSP 監視器
RTSP_SCHEME=rtsp
RTSP_HOST=192.168.1.100
RTSP_PORT=554
RTSP_USERNAME=admin
RTSP_PASSWORD=change-me
RTSP_PATH=/Streaming/Channels/101
RTSP_URL=
RTSP_TRANSPORT=tcp
RTSP_OPEN_TIMEOUT_SECONDS=10
RTSP_RECONNECT_DELAY_SECONDS=5

# YOLO
MODEL_PATH=/app/yolo26m.pt
YOLO_DEVICE=cpu
PERSON_CONFIDENCE=0.4
YOLO_IMAGE_SIZE=640

# 每秒取樣；15 秒內至少 2/3（10/15）次偵測到人就告警
SAMPLE_INTERVAL_SECONDS=1
DETECTION_WINDOW_SECONDS=15
DETECTION_MIN_RATIO=0.5
ALERT_COOLDOWN_SECONDS=300
MAX_FRAME_AGE_SECONDS=5

# SMTP：目前關閉，只輸出到 CMD。確認設定正確後再改成 true。
EMAIL_ENABLED=false

# Web 中控台
WEB_HOST=0.0.0.0
WEB_PORT=8080
CAMERA_CONFIG_PATH=data/cameras.json
ROI_DWELL_SECONDS=10
DASHBOARD_SETTINGS_PASSWORD=H0p@xIT@999
DASHBOARD_SESSION_SECRET=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=change-me
SMTP_USE_TLS=true
EMAIL_FROM=your-email@example.com
EMAIL_TO=your-email@example.com
EMAIL_SUBJECT=YOLO CAM person detected

LOG_LEVEL=INFO
